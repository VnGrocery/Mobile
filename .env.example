# Compile-time config, read via --dart-define-from-file=.env (Flutter's
# native reader, no flutter_dotenv dependency needed). Copy to .env and edit:
#   cp .env.example .env
#   flutter run --dart-define-from-file=.env
# .env is gitignored; .env.example in the repo is only ever this template.

# Domain/port the app talks to. Android emulator reaches the host machine at
# 10.0.2.2 (the code's own default if this is unset); iOS Simulator and
# desktop use 127.0.0.1; a real device needs your machine's LAN IP or a
# public domain.
API_BASE_URL=http://10.0.2.2:5050

# Web client ID for Google sign-in, used by the server to verify the ID
# token. Leave unset to disable the Google sign-in button.
GOOGLE_CLIENT_ID=
